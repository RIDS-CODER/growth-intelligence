# ── Enrose AI Social Autopilot — environment ────────────────────────────────
# Copy to .env. The file works UNEDITED: SQLite + mock AI + mock Instagram +
# local storage. Fill in credentials to promote each subsystem to production.
# NEVER commit a real .env.

APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=dev-only-change-me-in-production
API_BASE_URL=http://localhost:8000
FRONTEND_ORIGINS=http://localhost:3000

# ── Database ────────────────────────────────────────────────────────────────
# Production: postgresql+psycopg://user:password@host:5432/enrose
DATABASE_URL=sqlite:///./enrose.db

# ── AI (Claude) ─────────────────────────────────────────────────────────────
# Leave ANTHROPIC_API_KEY empty to run on the deterministic MOCK provider.
ANTHROPIC_API_KEY=
MODEL_STRONG=claude-opus-5
MODEL_BALANCED=claude-sonnet-5
MODEL_CHEAP=claude-haiku-4-5-20251001
AI_MAX_RETRIES=1
AI_DAILY_COST_CAP_USD=25.0

# ── Auth ────────────────────────────────────────────────────────────────────
# Local JWT is used when Supabase vars are empty.
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=720
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ── Storage (S3 / Cloudflare R2) ────────────────────────────────────────────
# Leave STORAGE_BUCKET empty to use local disk at STORAGE_LOCAL_DIR.
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=
STORAGE_LOCAL_DIR=./var/uploads

# ── Instagram / Meta Graph API ──────────────────────────────────────────────
# Leave META_APP_ID empty to use the MOCK publisher.
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_GRAPH_VERSION=v21.0
META_REDIRECT_URI=http://localhost:8000/api/v1/social/instagram/callback

# ── Workers ─────────────────────────────────────────────────────────────────
SCHEDULER_ENABLED=false
SCHEDULER_TICK_SECONDS=60
