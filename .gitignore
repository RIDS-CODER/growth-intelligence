# Runtime state — regenerated by the server, never commit.
# (git does not support trailing comments on a pattern line, so keep them above.)

# your daily Upstox access token — PRIVATE, contains credentials
token.json
# cached NSE symbol -> instrument-key map
instruments.json
# tracked-setup snapshots + resolved outcomes
setups.json
# paper-trading bot state
paper-state.json
# trades you told the watcher about (symbols, entries, leverage, Telegram chat ids)
positions.json
# market-health snapshot log — grows continuously, and is what the intel backtester reads
intel-history.jsonl

node_modules/
.DS_Store
